{
  "index_patterns": ["microcrm-dora-metrics*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "properties": {
        "timestamp": { "type": "date" },
        "eventType": { "type": "keyword" },
        "repo": { "type": "keyword" },
        "workflow": { "type": "keyword" },
        "conclusion": { "type": "keyword" },
        "branch": { "type": "keyword" },
        "run_id": { "type": "long" },
        "duration_minutes": { "type": "float" },
        "head_sha": { "type": "keyword" },
        "source": { "type": "keyword" },
        "ingest_source": { "type": "keyword" },
        "period_days": { "type": "integer" },
        "lead_time_minutes": { "type": "float" },
        "deployment_frequency_per_week": { "type": "float" },
        "mttr_hours": { "type": "float" },
        "change_failure_rate_pct": { "type": "float" },
        "ci_failure_rate_pct": { "type": "float" },
        "ci_runs": { "type": "integer" },
        "cd_runs": { "type": "integer" },
        "nightly_runs": { "type": "integer" },
        "bootstrap": { "type": "boolean" }
      }
    }
  }
}
